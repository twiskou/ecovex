// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema
//
// NOTE: SQLite does not support native enums.
// All enum-like fields use String type with enforced values at the application level.
// Valid values are documented in comments and validated by Zod schemas.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─── Models ───────────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  // role: "CITIZEN" | "VERIFIER" | "ADMIN"
  role         String   @default("CITIZEN")
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  profile           UserProfile?
  submissions       CollectionSubmission[]
  verifications     Verification[]
  pointTransactions PointTransaction[]
  auditLogs         AuditLog[]
  ecologicalGoals   EcologicalGoal[]

  @@index([email])
  @@index([role])
}

model UserProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  firstName   String
  lastName    String
  phone       String?
  city        String?
  avatarUrl   String?
  totalPoints Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model WasteCategory {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  color       String?
  iconName    String?
  pointValue  Int      @default(10)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  classifications AIClassification[]
  submissions     CollectionSubmission[]
  collectionPoints CollectionPointCategory[]
}

model AIClassification {
  id                String   @id @default(cuid())
  imageUrl          String
  predictedCategory String?
  confidence        Float?
  rawResult         String?
  // status: "PENDING" | "COMPLETED" | "UNCERTAIN" | "FAILED"
  status            String   @default("PENDING")
  submittedById     String
  categoryId        String?
  createdAt         DateTime @default(now())

  category   WasteCategory?       @relation(fields: [categoryId], references: [id])
  submission CollectionSubmission?

  @@index([submittedById])
  @@index([status])
}

model CollectionPoint {
  id          String   @id @default(cuid())
  name        String
  address     String
  city        String
  latitude    Float?
  longitude   Float?
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  acceptedCategories CollectionPointCategory[]
  submissions        CollectionSubmission[]

  @@index([city])
  @@index([isActive])
}

model CollectionPointCategory {
  collectionPointId String
  categoryId        String

  collectionPoint CollectionPoint @relation(fields: [collectionPointId], references: [id], onDelete: Cascade)
  category        WasteCategory   @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([collectionPointId, categoryId])
}

model CollectionSubmission {
  id                String   @id @default(cuid())
  citizenId         String
  collectionPointId String?
  categoryId        String?
  classificationId  String?  @unique
  // status: "PENDING" | "APPROVED" | "REJECTED" | "CANCELLED"
  status            String   @default("PENDING")
  quantityKg        Float?
  estimatedQuantity Boolean  @default(true)
  notes             String?
  // JSON array of image paths stored as string (SQLite has no JSON type)
  imageUrls         String   @default("[]")
  submittedAt       DateTime @default(now())
  updatedAt         DateTime @updatedAt

  citizen         User             @relation(fields: [citizenId], references: [id])
  collectionPoint CollectionPoint? @relation(fields: [collectionPointId], references: [id])
  category        WasteCategory?   @relation(fields: [categoryId], references: [id])
  classification  AIClassification? @relation(fields: [classificationId], references: [id])
  verification    Verification?
  pointTransaction PointTransaction?

  @@index([citizenId])
  @@index([status])
  @@index([submittedAt])
}

model Verification {
  id           String   @id @default(cuid())
  submissionId String   @unique
  verifierId   String
  // decision: "APPROVED" | "REJECTED"
  decision     String
  reason       String?
  verifiedAt   DateTime @default(now())

  submission CollectionSubmission @relation(fields: [submissionId], references: [id])
  verifier   User                 @relation(fields: [verifierId], references: [id])

  @@index([verifierId])
  @@index([verifiedAt])
}

model PointTransaction {
  id           String   @id @default(cuid())
  userId       String
  submissionId String?  @unique
  amount       Int
  // type: "EARNED" | "ADJUSTED" | "BONUS"
  type         String
  description  String?
  createdAt    DateTime @default(now())
  createdById  String?

  user       User                  @relation(fields: [userId], references: [id])
  submission CollectionSubmission? @relation(fields: [submissionId], references: [id])

  @@index([userId])
  @@index([createdAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String?
  entityId  String?
  details   String?
  ipAddress String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([createdAt])
  @@index([action])
}

model EcologicalGoal {
  id          String   @id @default(cuid())
  userId      String
  targetKg    Float
  period      String   @default("MONTHLY") // "WEEKLY" | "MONTHLY"
  categoryId  String?
  startDate   DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
